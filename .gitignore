# Also exclude archived/legacy pipelines and resources:
#   - unsupervised/
#   - weakly_super_cd/
#   - unsupervised_monthly/old_resources/

# Virtual environments
looting/
venv/
env/
dafals/

# Large data directories
looted-exp-new-change-detection/
planet_mosaics_final_4bands/
huggingface_models/
huggingface_models_backup/

# Code directories (exclude to keep repo small; allowlist unsupervised/ and weakly_super_cd/ below)
models/
training/
evaluation/
utils/
config/
dinov3/
old_model_scripts_backup/
related_papers/
.vscode/
logs/
results/
change_detection/plot_looting_months_and_splits.py

# Large subdirectories within kept folders
unsupervised/model_runs/
unsupervised/old_results/
unsupervised/masked_exp/
unsupervised/model_runs_masked_exp/
weakly_super_cd/evaluation_runs_masked/
